{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true
  },
  // Type-check (and lint) everything; tsconfig.build.json compiles src only.
  "include": ["src", "test", "vitest.config.ts", "codegen.ts"]
}
