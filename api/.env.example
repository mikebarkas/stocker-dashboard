# Copy to api/.env for local development; `npm run dev -w api` loads it.
# Never commit .env.

PORT=4000
# The web app's origin (CORS). Vite's dev server locally.
ALLOWED_ORIGIN=http://localhost:5173
# "production" turns GraphiQL off.
NODE_ENV=development

# Supabase session pooler, as the read-only role.
# The user is stocker_reader.<project-ref>
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=stocker_reader.<project-ref>
PGPASSWORD=
# Supabase CA certificate (Database > Settings > SSL Configuration).
# The same file the sync job uses works here.
PGSSLROOTCERT=../sync/prod-ca-2021.crt
