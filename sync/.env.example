# Copy to .env for local runs: uv run --env-file .env python -m stocker_sync
# Never commit .env.

# Homelab Postgres (source): read-only role on the "stock" table.
# Locally: kubectl port-forward (see README.md).
SOURCE_PGHOST=localhost
SOURCE_PGPORT=15432
SOURCE_PGDATABASE=stocker
SOURCE_PGUSER=stocker_sync
SOURCE_PGPASSWORD=

# Supabase (target): session pooler, port 5432.
# The user is <role>.<project-ref>, e.g. stocker_writer.abcdefghijklmn
TARGET_PGHOST=
TARGET_PGPORT=5432
TARGET_PGDATABASE=postgres
TARGET_PGUSER=stocker_writer.<project-ref>
TARGET_PGPASSWORD=
# Supabase CA certificate (Project Settings > Database > SSL Configuration).
TARGET_SSLROOTCERT=./supabase-ca.crt
