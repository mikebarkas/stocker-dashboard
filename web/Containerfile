# Web image: the built static app, served by nginx. Build from the repo root
# (npm workspaces share one lockfile):
#   docker build -f web/Containerfile -t stocker-web .

# Build stage: install, then `vite build` into web/dist. The generated
# GraphQL types are committed, so no codegen (and no API schema) is needed.
FROM node:24-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY api/package.json api/
COPY web/package.json web/
RUN npm ci --workspace web --ignore-scripts
COPY tsconfig.base.json ./
COPY web/ web/
# VITE_API_URL is read at build time; the default, /graphql, is same-origin
# (host Caddy proxies it to the API), so one image works on any domain.
RUN npm run build --workspace web

# Runtime stage: only the static files and an nginx config. No Node.
# nginx-unprivileged runs as a non-root user (UID 101) on port 8080.
FROM nginxinc/nginx-unprivileged:1.30-alpine
COPY web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web/dist /usr/share/nginx/html
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["wget", "-q", "--spider", "http://127.0.0.1:8080/"]
