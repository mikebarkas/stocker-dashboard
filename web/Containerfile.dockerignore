# Ignore file for web/Containerfile (BuildKit reads <Containerfile>.dockerignore).
# The build context is the repo root.
# Only what the image needs; everything else stays out, especially secrets.

# Dependencies and build output: the image installs and builds its own.
**/node_modules
**/dist
**/coverage

# Secrets and certificates.
**/.env
**/.env.*
!**/.env.example
**/*.crt

# Not needed for the web image.
.git
.github
.claude
**/.DS_Store
db
sync
web/src/test
**/*.test.ts
**/*.test.tsx
# api: only its package.json, because npm checks every workspace's
# manifest against the root package-lock.json.
api/*
!api/package.json
