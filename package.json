{
  "name": "stocker-dashboard",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
